[
  {
    "log": {
      "loglevel": "warning"
    },
    "inbounds": [
      {
        "listen": "127.0.0.1",
        "port": 10819,
        "protocol": "http",
        "settings": {
          "timeout": 0,
          "allowTransparent": false,
          "userLevel": 0
        },
        "tag": "http-in"
      }
    ],
    "outbounds": [
      {
        "protocol": "vless",
        "settings": {
          "vnext": [
            {
              "address": "clover.filnex.baby",
              "port": 443,
              "users": [
                {
                  "id": "80a06811-f74b-4b82-ac99-7e66c2a98e1c",
                  "encryption": "none",
                  "flow": ""
                }
              ]
            }
          ]
        },
        "streamSettings": {
          "network": "ws",
          "security": "tls",
          "tlsSettings": {
            "serverName": "clover.filnex.baby",
            "allowInsecure": true,
            "fingerprint": "android",
            "alpn": [
              "h2",
              "http/1.1"
            ]
          },
          "wsSettings": {
            "path": "/api/de6/stream",
            "headers": {
              "Host": "clover.filnex.baby"
            }
          }
        },
        "tag": "proxy"
      },
      {
        "protocol": "freedom",
        "tag": "direct"
      }
    ],
    "routing": {
      "domainStrategy": "IPIfNonMatch",
      "rules": [
        {
          "type": "field",
          "ip": [
            "geoip:private"
          ],
          "outboundTag": "direct"
        }
      ]
    }
  }
]