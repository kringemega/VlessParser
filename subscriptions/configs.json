[
  {
    "log": {
      "loglevel": "warning"
    },
    "inbounds": [
      {
        "listen": "127.0.0.1",
        "port": 10816,
        "protocol": "http",
        "settings": {
          "timeout": 0,
          "allowTransparent": false,
          "userLevel": 0
        },
        "tag": "http-in"
      }
    ],
    "outbounds": [
      {
        "protocol": "vless",
        "settings": {
          "vnext": [
            {
              "address": "putin.colorbox.space",
              "port": 80,
              "users": [
                {
                  "id": "a3a146d7-ed3c-4da6-bbb4-0a4eb1f57db5",
                  "encryption": "none",
                  "flow": ""
                }
              ]
            }
          ]
        },
        "streamSettings": {
          "network": "ws",
          "security": "none",
          "wsSettings": {
            "path": "/",
            "headers": {
              "Host": "putin.colorbox.space"
            }
          }
        },
        "tag": "proxy"
      },
      {
        "protocol": "freedom",
        "tag": "direct"
      }
    ],
    "routing": {
      "domainStrategy": "IPIfNonMatch",
      "rules": [
        {
          "type": "field",
          "ip": [
            "geoip:private"
          ],
          "outboundTag": "direct"
        }
      ]
    }
  }
]